FROM node:20-alpine AS builder

WORKDIR /app

# No NEXT_PUBLIC_* build argument is accepted, and that is deliberate rather
# than an omission. Nothing in the browser bundle calls the API: every backend
# request is made server-side, either from an app/api/ route handler or from a
# server component, both reading API_URL at runtime. NEXT_PUBLIC_API_URL
# survives only as a fallback in lib/api.ts for a standalone `npm run dev`,
# which never goes through this image. Baking it in here would inline a value
# no browser code reads and imply the browser talks to the API directly.

COPY package*.json .
RUN npm ci

COPY . .
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.mjs ./next.config.mjs

# Render supplies PORT at runtime. The fallback keeps direct local use simple.
CMD ["sh", "-c", "npm run start -- -p ${PORT:-3000}"]
