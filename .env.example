# GaitDesk - Environment Variables Template
# Copy this file to .env and fill in your local values
# NEVER commit the .env file to version control

# ============================================================
# BACKEND CONFIGURATION
# ============================================================

# Server
BACKEND_HOST=localhost
BACKEND_PORT=8000
DEBUG=True

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ORIGINS=http://localhost:3000
INTERNAL_API_KEY=your-internal-api-key-change-in-production

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# PostgreSQL Connection.
# Point this at a Neon *development branch*, not at the branch production
# serves from. See docs/deployment.md, "Keep development off the production
# database".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/horse_show_db

# The Neon host production serves from, e.g.
# ep-xxxx-xxxx.us-east-2.aws.neon.tech. database/migrate.ps1 refuses to run
# against it unless -AllowProduction is passed. Leave unset and the runner
# migrates whatever DATABASE_URL names, with no guard.
PRODUCTION_DATABASE_HOST=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=horse_show_db

# Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================

# API Configuration.
# API_URL is what the frontend actually reads for every backend request, all of
# which are made server-side. NEXT_PUBLIC_API_URL is only a fallback for a
# standalone `npm run dev`; docker-compose and the production image both set
# API_URL, and the production build bundles no public copy of it.
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=30000

# App Configuration
NEXT_PUBLIC_APP_NAME=GaitDesk
NEXT_PUBLIC_APP_VERSION=0.1.0

# Environment
NODE_ENV=development
NEXT_DEBUG=false

# ============================================================
# AUTHENTICATION
# ============================================================

# NextAuth Secret (for session signing)
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# Password
PASSWORD_MIN_LENGTH=8

# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=json

# ============================================================
# DOCUMENT EXTRACTION
# ============================================================

# Reads dates, registration numbers, and vet details off uploaded Coggins,
# health certificates, and registration papers so the uploader confirms them
# instead of typing them. Optional: leave it unset and the upload form works
# exactly as it did before, by hand.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ============================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================

# Email. These are the names backend/mailer.py actually reads — SMTP_SERVER,
# SMTP_USERNAME and SMTP_FROM_EMAIL were listed here for a long time and are
# read by nothing, so a filled-in .env silently sent no mail. Unset SMTP_HOST
# is a supported state: mailer.py returns None and never raises, and every flow
# that mails a link also returns it for copy/paste.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@gaitdesk.example
SMTP_STARTTLS=true

# File Storage (for future photo uploads)
STORAGE_TYPE=local
STORAGE_PATH=./storage
# Or S3:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_BUCKET=your-bucket

# ============================================================
# DEVELOPMENT ONLY
# ============================================================

# Enable test data seeding on startup
SEED_TEST_DATA=False

# Drop and recreate database on startup (DANGER!)
DROP_DB_ON_STARTUP=False

# Enable API documentation
ENABLE_API_DOCS=True
